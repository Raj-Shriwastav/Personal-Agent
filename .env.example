# Copy to .env and fill in real values. .env is git-ignored; this file is not.

# --- App ---
APP_ENV=development
DEBUG=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personal_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me

# --- Frontend origin allowed by CORS ---
FRONTEND_ORIGIN=http://localhost:5173

